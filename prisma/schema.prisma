// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Module {
  id      String      @id @default(uuid())
  name    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theoricLessons TheoricLesson[]
  praticalLessons PraticalLesson[]
}

model TheoricLesson {
  id      String      @id @default(uuid())
  lessonName    String
  xpEarned Int
  description String
  content Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id])
  moduleId String

}

model PraticalLesson {
  id      String      @id @default(uuid())
  lessonName    String
  xpEarned Int
  description String
  alternative1 String
  alternative2 String
  alternative3 String
  alternative4 String
  correctAlternative Int
  urlAlternative1 String
  urlAlternative2 String
  urlAlternative3 String
  urlAlternative4 String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id])
  moduleId String
}
